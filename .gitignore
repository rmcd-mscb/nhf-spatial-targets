# pixi
.pixi/
*.tar.bz2
*.conda

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# run workspaces and large data (not committed)
runs/
data/
outputs/
logs/

# credentials (never commit)
.credentials.yml
*/.credentials.yml

# environment
.env
.venv/

# editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# worktrees
.worktrees/

# pytest
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Claude Code runtime (settings.json and settings.local.json ARE tracked)
.claude/scheduled_tasks.lock

# Advisory flock sidecar for the release publish-state registry. Created by
# release/registry.py's flock-protected writes; transient, never committed.
catalog/release_registry.yml.lock

# Inspection-notebook figures live under docs/figures/<group>/<project>/
# and are committed — regenerate with `pixi run render-figures` (local) or
# the inspect_*.slurm scripts (HPC). Cache files from notebook execution
# are still ignored.
docs/figures/.cache/

# MkDocs build output (issue #233). `pixi run docs-build` writes here;
# `pixi run docs-serve` does not need this dir (it serves from memory).
_site/
